! Stockholm, basic editor palette.

%pal
    background : [0, 0, 0]
    console : [255, 255, 255]
    console_text : [255, 255, 255]
    console_background : [0, 0, 0]
    console_cursor : [160, 160, 160]
    cursor : [160, 160, 160]
    cursor_mode : [0, 255, 255]
    text_seperators : [255, 255, 255]
    line_info : [128, 128, 128]
    file : [255, 255, 0]
    cwd : [255, 0, 255]
    cwd_dir : [96, 96, 96]
    cwd_file : [160, 160, 160]
    dirty : [192, 192, 192]
    clean : [255, 255, 255]
    text_base : [192, 192, 192]
    text_lines : [192, 192, 192]
    
    selection_colour : [50, 150, 250]

    msg_background : [0, 0, 0]
    msg_foreground : [255, 255, 255]
    msg_err : [255, 64, 64]
    msg_guide : [64, 255, 64]
    msg_info : [64, 64, 255]

    ! file q entry
    file_q_entry : [64, 64, 64]
     
    ! current open file in the q
    current_file_entry : [192, 192, 192]
    
    ! file q background colour
    file_q_color : [0, 0, 0]
    
    ! Open file colour in the console
    open_file_color : [255, 255, 255]
    
    ! cursor fragment color
    frag : [0, 128, 192]

    ! post-lexical analysis, highlighting

    lex_id : [192, 192, 192]
    lex_comm : [128, 128, 128]
    lex_key : [64, 128, 255]
    lex_num : [255, 128, 64]
    lex_op : [255, 255, 0]
    lex_str : [64, 255, 64]
    lex_pun : [255, 255, 255]
    lex_misc : [255, 64, 255]
%pal