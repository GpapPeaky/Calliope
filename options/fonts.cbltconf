!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! LOAD FONT FROM assets/font/XXX.tff   !
!                                      !
! Keep in mind all fonts need to be    !
!.ttf, mono and the name provided      !
! in the config file needs to be       !
! exactly the same as in the           !
! assets/font/ folder.                 !
!                                      !
! The number next to the font name     !
! is it's initial TAB_SIZE             !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

%fonts
    !* Text font *!
    TEXT_FONT            : IBMPlexMono-Regular 23
    !* Console font *!
    CONSOLE_FONT         : IBMPlexMono-Regular 20
    
    !* Topbar info font *!
    TOPBAR_FONT          : IBMPlexMono-Regular 24
    
    !* Filequeue entries font *!
    FQ_FONT              : IBMPlexMono-Regular 20
%fonts
