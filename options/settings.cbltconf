%settings
    USER_TERMINAL_POSIX : kitty
    USER_TERMINAL_WIN32 : pwsh.exe

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! PALETTES CAN BE FOUND AT THE          ! 
! options/palettes folder               !
!                                       !
! Ready for use palettes:               !
!                                       !
! Aland                                 !
! Kalmar                                !
! Kiruna                                !
! Lund                                  !
! Malmo                                 !
! Uppsala                               !
! Stockholm (def)                       !
!                                       !
! You can of course add and/or change   !
! existing palettes                     !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

    PALETTE             : Stockholm

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! AVAILABLE CURSOR SYMBOLS              !
!                                       !
! UNDESCORE                             !
! BOX                                   !
! HOLLOW                                !
! LINE (def)                            !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

    CURSOR_SYMBOL            : HOLLOW

    TAB_SIZE                 : 4

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! LOAD FONT FROM assets/font/XXX.tff   !
!                                      !
! Keep in mind all fonts need to be    !
!.ttf, mono and the name provided      !
! in the config file needs to be       !
! exactly the same as in the           !
! assets/font/ folder.                 !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

    TEXT_FONT            : IBMPlexMono-Regular 
    CONSOLE_FONT         : IBMPlexMono-Regular
    TOPBAR_FONT          : IBMPlexMono-Regular
    FQ_FONT              : IBMPlexMono-Regular

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! FROM options/anim/                    !
!                                       !
! ie file/animation.cbltconf will need  !
! to be file/animation in the settings  !
! file option                           !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

    ANIM_FILE_CURSOR_PROFILE     : cursor/ease
    ANIM_CONSOLE_CURSOR_PROFILE  : console_cursor/ease
    ANIM_CONSOLE_CONTENT_PROFILE : console_content/ease
    ANIM_CONSOLE_PROFILE         : console/ease
    ANIM_FQ_PROFILE              : fq/ease
%settings