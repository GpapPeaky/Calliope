%settings
    USER_TERMINAL_POSIX : kitty
    USER_TERMINAL_WIN32 : pwsh.exe
    PALETTE             : Stockholm

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! AVAILABLE CURSOR MACROS               !
!                                       !
! UNDESCORE                             !
! BOX                                   !
! HOLLOW                                !
! LINE                                  !
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

