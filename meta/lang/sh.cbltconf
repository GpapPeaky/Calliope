%lang CLASS_SCRIPT

    %keywords:
        %controlFlow:
            if then else elif fi for while do done case esac break continue
        %end

        %storageClass:
        %end

        %typeQualifiers:
        %end

        %userDefinedClass:
        %end
        
        %utility:
            function return exit export unset readonly
        %end
        
        %dataTypes:
        %end
    %end

    %operators:
        = == != -eq -ne -lt -gt -le -ge
        && || !
        | & > < >> <<
    %end

    %commentBlock:
    %end

    %commentLine:
        #
    %end  

    %commentNotes:
        TODO:
        FIXME:
    %end:

    %stringDelim:
        ' '
        " "
        ` `
    %end

    %annotations:
    %end

    %punctuation:
        ( ) { } [ ] ; ,
    %end

    %macros:
        $
    %end

    %settings:
        mls: true
        hex: false
        bin: false
        esc: true
    %end
%lang