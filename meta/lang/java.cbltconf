%lang CLASS_CLIKE
    %keywords:
        %controlFlow:
            if else switch case default
            for while do break continue
            try catch finally throw throws
            return yield
            assert
        %end

        %storageClass:
            public private protected
            static final abstract
            transient volatile synchronized native strictfp
        %end

        %typeQualifiers:
            final var
        %end

        %userDefinedClass:
            class interface enum record
            extends implements permits sealed non-sealed
        %end
        
        %utility:
            new this super instanceof
        %end
        
        %dataTypes:
            int char float double void short long byte boolean
        %end
    %end


    %operators:
        + - * / % 
        = == != < > <= >= 
        && || ! 
        & | ^ ~ << >> >>> 
        += -= *= /= %= &= |= ^= <<= >>= >>>=
        ++ -- 
        . 
        ? :
    %end


    %commentBlock:
        /* */
    %end

    %commentLine:
        //
    %end  

    %commentNotes:
        TODO:
        FIXME:
    %end:


    %stringDelim:
        ' '
        " "
    %end

    %annotations:
        @
    %end

    %punctuation:
        ( ) { } [ ] ; , .
    %end


    %macros:
        import
        package
    %end

    %settings:
        mls: true
        hex: true
        bin: false
        esc: true
    %end

%lang