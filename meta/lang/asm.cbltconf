%lang CLASS_SCRIPT
    %keywords:
        %controlFlow:
            jmp je jne jz jnz ja jae jb jbe jg jge jl jle
            jc jnc jo jno js jns jp jnp
            call ret loop loope loopne
            int iret syscall sysret sysenter sysexit
        %end

        %storageClass:
            al ah bl bh cl ch dl dh
            ax bx cx dx si di bp sp
            eax ebx ecx edx esi edi ebp esp
            rax rbx rcx rdx rsi rdi rbp rsp rip
            r8 r9 r10 r11 r12 r13 r14 r15
            cs ds es fs gs ss
            xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7
            xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15
        %end

        %typeQualifiers:
            byte word dword qword
        %end

        %userDefinedClass:
            mov lea push pop xchg
            add sub mul imul div idiv inc dec neg
            and or xor not test cmp
            shl shr sar rol ror
            movs lods stos cmps scas
            clc stc cli sti cld std
            nop hlt pause
        %end
        
        %utility:
            db dw dd dq equ org section global extern align bits
        %end
        
        %dataTypes:

        %end
    %end


    %operators:
        + - * / 
    %end


    %commentBlock:
    %end

    %commentLine:
        ;
    %end  

    %commentNotes:
        TODO:
        FIXME:
    %end:


    %stringDelim:
        " "
    %end


    %annotations:
    %end


    %punctuation:
        , : [ ]
    %end


    %macros:
        %
    %end


    %settings:
        mls: false
        hex: true
        bin: true
        esc: false
    %end

%lang