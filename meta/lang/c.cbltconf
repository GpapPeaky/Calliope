! C

%lang CLASS_CLIKE

    %keywords:
        %controlFlow:
            if
            else
            switch
            case
            default
            for
            while
            do
            break
            continue
        %end

        %storageClass:
            register
            static
            extern
        %end

        %typeQualifiers:
            const
            volatile
        %end

        %userDefinedClass:
            struct
            enum
            union
        %end
        
        %utility:
            inline
            sizeof
            return
            goto
            typedef
        %end
        
        %dataTypes:
            int
            char
            float
            double
            void
            short
            long
            signed
            unsigned
        %end
    %end

    %operators:
        + - * / % 
        = == != < > <= >= 
        && || ! 
        & | ^ ~ << >> 
        += -= *= /= %= &= |= ^= <<= >>= 
        ++ -- 
        . -> :: 
        ? : 
    %end

    %commentBlock:
        /* */
    %end

    %commentLine:
        //
    %end  

    %stringDelim:
        ' '
        " "
    %end

    %annotations:
    %end

    %punctuation:
        ( ) { } [ ] ; ,
    %end

    %macros:
        #
    %end

    %settings:
        mls:   false
        hex:   true
        bin:   false
        esc:   true
    %end
%lang
