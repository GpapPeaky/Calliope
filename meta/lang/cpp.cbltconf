> C++

%lang CLASS_CLIKE

    %keywords:
        %controlFlow:
            if else switch case default for while do break continue
            try catch throw
        %end

        %storageClass:
            auto register static extern mutable thread_local
        %end

        %typeQualifiers:
            const volatile constexpr
        %end

        %userDefinedClass:
            class struct enum union namespace
        %end
        
        %utility:
            sizeof return goto typedef using new delete this operator
        %end
        
        %dataTypes:
            int char float double void short long signed unsigned bool wchar_t
        %end
    %end

    %operators:
        + - * / % 
        = == != < > <= >= 
        && || ! 
        & | ^ ~ << >> 
        += -= *= /= %= &= |= ^= <<= >>= 
        ++ -- 
        . -> :: .* ->*
        ? :
    %end

    %commentBlock:
        /* */
    %end

    %commentLine:
        //
    %end  

    %stringDelim:
        ' ' 
        " "
    %end

    %annotations:
    %end

    %punctuation:
        ( ) { } [ ] ; , :
    %end

    %macros:
        #
    %end

    %settings:
        mls: true
        hex: true
        bin: true
        esc: true
    %end
%lang