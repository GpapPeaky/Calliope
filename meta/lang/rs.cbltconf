%lang CLASS_CLIKE

    %keywords:
        %controlFlow:
            if else match for while loop break continue return
        %end

        %storageClass:
            static const mut
        %end

        %typeQualifiers:
            mut
        %end

        %userDefinedClass:
            struct enum union trait impl mod
        %end
        
        %utility:
            let fn pub use crate super self as move
        %end
        
        %dataTypes:
            i8 i16 i32 i64 i128 isize
            u8 u16 u32 u64 u128 usize
            f32 f64 bool char str
        %end
    %end

    %operators:
        + - * / % 
        = == != < > <= >= 
        && || ! 
        & | ^ << >> 
        += -= *= /= %= &= |= ^= <<= >>= 
        .
        ? 
    %end

    %commentBlock:
        /* */
    %end

    %commentLine:
        //
    %end  

    %commentNotes:
        TODO:
        FIXME:
    %end:

    %stringDelim:
        ' '
        " "
    %end

    %annotations:
        #
    %end

    %punctuation:
        ( ) { } [ ] ; , :
    %end

    %macros:
        
    %end

    %settings:
        mls: true
        hex: true
        bin: true
        esc: true
    %end
%lang