# TEST AND LOCK
# 
# LOCK == 0 -> Unlocked else LOCK == 1 -> locked, proc already inside the region

ENTER:
    TSL R, LOCK # Copy the value of the lock to the register, set lock to 1
    CMP R, 0X0  # Check if unlocked
    JNE ENTER   # If lock is 1, go back and try again
    RET         # Region entered

LEAVE:
    MOV LOCK, 0X0 # Unlock
    RET
