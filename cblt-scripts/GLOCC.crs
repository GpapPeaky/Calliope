!
!   CBLT.codes.log                                  -> Log codes (LAMDA)
!       CBLT.codes.log.filedq                       -> def: 'LAMDA 1  | 1.01'  | File dequeued
!       CBLT.codes.log.filenq                       -> def: 'LAMDA 0  | 1.00'  | File enqueued
!       CBLT.codes.log.exit                         -> def: 'LAMDA 2  | 1.02'  | Exit
!       CBLT.codes.log.write                        -> def: 'LAMDA 3  | 1.03'  | Write
!       CBLT.codes.log.help                         -> def: 'LAMDA 4  | 1.04'  | Help
!       CBLT.codes.log.openfileexp                  -> def: 'LAMDA 5  | 1.05'  | Open file explorer
!       CBLT.codes.log.deldir                       -> def: 'LAMDA 6  | 1.06'  | Delete directory
!       CBLT.codes.log.newdir                       -> def: 'LAMDA 7  | 1.07'  | Make directory
!       CBLT.codes.log.newfile                      -> def: 'LAMDA 8  | 1.08'  | Create file
!       CBLT.codes.log.delfile                      -> def: 'LAMDA 9  | 1.09'  | Removed file
!       CBLT.codes.log.info                         -> def: 'LAMDA 10 | 110'   | Info
!       CBLT.codes.log.gotoline                     -> def: 'LAMDA 11 | 111'   | Go to line
!       CBLT.codes.log.find                         -> def: 'LAMDA 12 | 112'   | Find string in file
!       CBLT.codes.log.changedir                    -> def: 'LAMDA 13 | 113'   | Change CWD
!
