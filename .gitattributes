# Sources
*.c     text diff=cpp
*.cc    text diff=cpp
*.cxx   text diff=cpp
*.cpp   text diff=cpp
*.cpi   text diff=cpp
*.c++   text diff=cpp
*.hpp   text diff=cpp
*.h     text diff=cpp
*.h++   text diff=cpp
*.hh    text diff=cpp

# Compiled Object files
*.slo   binary
*.lo    binary
*.o     binary
*.obj   binary

# Precompiled Headers
*.gch   binary
*.pch   binary

# Compiled Dynamic libraries
*.so    binary
*.dylib binary
*.dll   binary

# Compiled Static libraries
*.lai   binary
*.la    binary
*.a     binary
*.lib   binary

# Executables
*.exe   binary
*.out   binary
*.app   binary

# Override language
*.c     linguist-language=cpp
*.cc    linguist-language=cpp
*.cxx   linguist-language=cpp
*.cpp   linguist-language=cpp
*.cpi   linguist-language=cpp
*.c++   linguist-language=cpp
*.hpp   linguist-language=cpp
*.h     linguist-language=cpp
*.h++   linguist-language=cpp
*.hh    linguist-language=cpp
*.conf  linguist-language=ini
*.lang  linguist-language=ini
